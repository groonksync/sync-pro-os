# ============================================
# INEFABLE (WEB) — Variables de Entorno
# Copia este archivo como .env.local y completa los valores
# NUNCA subas el archivo .env.local al repositorio
# ============================================

# Supabase — URL del proyecto y Anon Key (pública para cliente RLS)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# APIs de Inteligencia Artificial (Servidor / Proxy Seguro Vercel)
# NOTA: Sin prefijo VITE_ para evitar que se empaqueten en el bundle del navegador
GEMINI_API_KEY=tu-gemini-api-key-aqui
DEEPSEEK_API_KEY=tu-deepseek-api-key-aqui
OPENROUTER_API_KEY=tu-openrouter-api-key-aqui
